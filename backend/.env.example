# Local development values. Copy to .env and replace the placeholders.
# Never commit the .env file.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_UPLOAD_DIR=uploads
ADMIN_SEED_KEY=choose-a-one-time-admin-registration-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
